{
  "id": "./",
  "name": "On Bade — raconte ce qui t'est arrivé",
  "short_name": "On Bade",
  "description": "Le réseau social où l'on raconte les galères du quotidien pour faire rire tout le monde. Signé ou en Badeur anonyme.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#1a1919",
  "theme_color": "#1a1919",
  "categories": ["social", "entertainment"],
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Bader", "short_name": "Bader", "description": "Raconter une nouvelle histoire", "url": "./#/compose", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Notifications", "short_name": "Notifs", "url": "./#/notifications", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "handle_links": "preferred",
  "prefer_related_applications": false
}
