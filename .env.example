# Copie ce fichier en .env (ou .env.local) pour régler l'app sans toucher au code.
# Seules les variables qui commencent par VITE_ sont lues par le site.

# Adresse de l'API du backend Next.js (onbad-backend).
VITE_API_URL=http://localhost:3000/api

# false = mode démo : tout est simulé dans le navigateur, aucun appel au serveur.
VITE_USE_BACKEND=true

# Le fil, les commentaires, le profil, les notifications, les stickers… viennent du backend (par défaut).
# false = seule la connexion passe par le backend, le contenu reste simulé dans le navigateur.
VITE_BACKEND_CONTENT=true
