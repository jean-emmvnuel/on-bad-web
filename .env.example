# Copie ce fichier en .env (ou .env.local) pour régler l'app sans toucher au code.

# Adresse de l'API du backend Next.js (onbad-backend).
VITE_API_URL=http://localhost:3000/api

# false = mode démo : tout est simulé dans le navigateur, aucun appel au serveur.
VITE_USE_BACKEND=true

# true = le fil, les commentaires, le profil… viennent aussi du backend.
# À activer quand les routes décrites dans API.md existeront (aujourd'hui : seulement /login et /register).
VITE_BACKEND_CONTENT=false
